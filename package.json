{
  "name": "general-marketing-intelligence",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A reusable MCP decision layer for direct Google and CSV-backed marketing intelligence.",
  "license": "Apache-2.0",
  "author": "Gourav Kondadadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gourav2411/general-marketing-intelligence.git"
  },
  "homepage": "https://github.com/Gourav2411/general-marketing-intelligence#readme",
  "bugs": {
    "url": "https://github.com/Gourav2411/general-marketing-intelligence/issues"
  },
  "engines": {
    "node": ">=20 <23"
  },
  "keywords": [
    "mcp",
    "marketing-intelligence",
    "ga4",
    "search-console",
    "analytics"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "demo": "node scripts/demo.mjs",
    "import:csv": "node scripts/import-csv.mjs",
    "setup": "npm run build && node scripts/setup.mjs",
    "connect:google": "npm run build && node scripts/setup.mjs --google-only",
    "doctor": "npm run build && node scripts/doctor.mjs",
    "doctor:live": "npm run build && node scripts/doctor.mjs --live",
    "typecheck": "tsc --noEmit",
    "test:marketing": "node scripts/marketing-decision-test.mjs",
    "test:ai": "node scripts/ai-layer-test.mjs",
    "test:local": "node scripts/local-data-test.mjs",
    "test:google": "node scripts/google-connectors-test.mjs",
    "test:connectors": "node scripts/connectors-test.mjs",
    "test:mcp": "node scripts/smoke-test.mjs",
    "test": "npm run build && npm run test:marketing && npm run test:ai && npm run test:local && npm run test:google && npm run test:connectors && npm run test:mcp",
    "verify": "npm run build && npm run typecheck && npm run test:marketing && npm run test:ai && npm run test:local && npm run test:google && npm run test:connectors && npm run test:mcp"
  },
  "dependencies": {
    "@google-analytics/data": "7.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "csv-parse": "6.1.0",
    "googleapis": "178.0.0",
    "openai": "7.8.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
